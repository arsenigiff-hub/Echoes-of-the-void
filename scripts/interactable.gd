class_name Interactable
extends Node3D

# "Пульт" для всего, с чем можно взаимодействовать.
#
# Зачем он нужен: игрок не должен знать, радио перед ним, терминал или шкаф.
# Игрок нашёл лучом объект, спросил "ты Interactable?" и позвал interact().
# Что происходит дальше — дело самого предмета.
#
# Любой предмет наследует этот класс (extends Interactable) и переопределяет
# то, что ему нужно. Остальное можно не трогать.


## Одно нажатие E, когда луч смотрит на предмет.
## Второе нажатие E, когда игрок уже "внутри" предмета (выход) — тоже сюда.
func interact(_player: CharacterBody3D) -> void:
	pass


## Игрок "внутри" предмета: сюда приходит каждое нажатие клавиши.
## E и F сюда не доходят — их забирает player.gd (E = выход, F = фонарь).
## Автоповтор (echo) уже отфильтрован, так что одно нажатие = один вызов.
func focus_input(_event: InputEvent) -> void:
	pass
